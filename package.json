{
  "name": "kippu-api",
  "version": "0.0.0",
  "private": true,
  "description": "Kippu platform APIs",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:deps": "pnpm --filter @kippu/sponsorship --filter @kippu/metadata-schema build",
    "build": "pnpm build:deps && tsc -p tsconfig.build.json && pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm build:deps && tsc --noEmit && pnpm --filter \"./packages/**\" typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "pnpm build:deps && vitest run",
    "lint:personal-data": "pnpm --filter @kippu/metadata-schema lint:personal-data",
    "check:contract": "scripts/check-api-contract.sh",
    "changeset": "changeset",
    "start": "node dist/server.js",
    "migrate": "node dist/store/migrate-cli.js",
    "store:up": "docker compose up -d --wait",
    "vendor:libticketto": "scripts/vendor-libticketto.sh",
    "vendor:check": "scripts/vendor-libticketto.sh --check",
    "metadata:publish-schemas": "node dist/metadata/publish-schemas-cli.js",
    "metadata:edge": "node dist/metadata/edge-server.js",
    "metadata:check-self-contained": "node dist/metadata/check-self-contained-cli.js",
    "sponsor:start": "node dist/sponsor/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@bloque/payments": "0.2.1",
    "@kippu/metadata-schema": "workspace:*",
    "@kippu/sponsorship": "workspace:*",
    "@simplewebauthn/server": "14.0.2",
    "@ticketto/backend-memory": "file:vendor/libticketto/ticketto-backend-memory-0.0.0.tgz",
    "@ticketto/binding-offchain": "file:vendor/libticketto/ticketto-binding-offchain-0.0.0.tgz",
    "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
    "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz",
    "@trpc/server": "11.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "@trpc/client": "11.18.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@ticketto/backend-memory": "file:vendor/libticketto/ticketto-backend-memory-0.0.0.tgz",
      "@ticketto/ledger-rules": "file:vendor/libticketto/ticketto-ledger-rules-0.0.0.tgz",
      "@ticketto/log": "file:vendor/libticketto/ticketto-log-0.0.0.tgz",
      "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
      "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz"
    }
  }
}
