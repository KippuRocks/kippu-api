{
  "name": "kippu-api",
  "version": "0.0.0",
  "private": true,
  "description": "Kippu platform APIs",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@trpc/client": "11.18.0",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
