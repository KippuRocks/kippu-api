{
  "name": "kippu-api",
  "version": "0.0.0",
  "private": true,
  "description": "Kippu platform APIs",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter \"./packages/**\" build",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/**\" typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "lint:personal-data": "pnpm --filter @kippu/metadata-schema lint:personal-data",
    "check:contract": "scripts/check-api-contract.sh",
    "changeset": "changeset",
    "start": "node dist/server.js",
    "migrate": "node dist/store/migrate-cli.js",
    "store:up": "docker compose up -d --wait",
    "vendor:libticketto": "scripts/vendor-libticketto.sh",
    "vendor:check": "scripts/vendor-libticketto.sh --check"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.2",
    "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
    "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz",
    "@trpc/server": "11.18.0",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "@trpc/client": "11.18.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
      "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz"
    }
  }
}
