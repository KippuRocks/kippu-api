{
  "name": "@kippu/metadata-schema",
  "version": "0.0.0",
  "description": "JSON Schemas for Kippu's public metadata documents (C6)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "schemas",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./event/1.0.json": "./schemas/event/1.0.json",
    "./class/1.0.json": "./schemas/class/1.0.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:personal-data": "node dist/src/lint-cli.js schemas/*/*.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
