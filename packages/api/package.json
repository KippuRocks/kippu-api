{
  "name": "@kippurocks/api",
  "version": "0.0.0",
  "description": "Types of the Kippu API's tRPC router (C5), for clients to compile against",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.d.ts"
  ],
  "types": "./dist/packages/api/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/api/src/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@trpc/server": "^11.18.0"
  }
}
